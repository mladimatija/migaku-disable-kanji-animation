{
	"compilerOptions": {
		/* Target Chrome's MV3 floor (Chrome 102+, supports ES2022 natively). */
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],

		/* ESM everywhere, bundler-style resolution - Vite handles the actual resolve. */
		"module": "ESNext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,

		"verbatimModuleSyntax": true,
		"isolatedModules": true,

		/* Vite owns the build; tsc is only used for type-checking. */
		"noEmit": true,

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,

		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["chrome", "node"]
	},
	"include": ["src/**/*.ts", "vite.config.ts", "tests/**/*.ts", "playwright.config.ts"],
	"exclude": ["node_modules", "dist", "test-results", "playwright-report"]
}
