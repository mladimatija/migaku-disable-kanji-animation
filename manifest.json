{
	"manifest_version": 3,
	"name": "__MSG_extensionName__",
	"version": "1.0.0",
	"description": "__MSG_extensionDescription__",
	"default_locale": "en",
	"homepage_url": "https://github.com/mladimatija/migaku-disable-kanji-animation",
	"content_scripts": [
		{
			"matches": ["https://study.migaku.com/*"],
			"js": ["src/content.ts"],
			"css": ["src/styles.css"],
			"run_at": "document_start"
		}
	],
	"icons": {
		"16": "icons/icon-16.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	}
}
